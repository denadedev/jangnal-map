# Optional: NAVER Maps Web Dynamic Map API client ID.
# Leave unset to use the built-in list-only fallback.
NEXT_PUBLIC_NAVER_MAPS_CLIENT_ID=

# Required to accept reports through Gmail SMTP.
# Turn on two-step verification and use an app password.
SMTP_USER=
SMTP_PASS=

# Optional. Defaults to SMTP_USER when omitted.
REPORT_TO_EMAIL=
